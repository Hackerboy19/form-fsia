# Copy into the upload directory (uploads/cms/). Files here are served as
# static images only; nothing in this folder may execute.
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?!(jpe?g|png|webp)$)[^.]+$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
