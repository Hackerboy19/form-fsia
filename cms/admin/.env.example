# Copy to .env.local.
# Production: full URL of the backend's api/ folder.
VITE_API_BASE=https://www.fsia.in/cms/backend/api
# Development: leave VITE_API_BASE as /api and set where `php -S` serves backend/.
# VITE_API_BASE=/api
# VITE_DEV_API_TARGET=http://127.0.0.1:8099
# Public site, used to preview images saved as root-relative paths (/static/media/...).
VITE_SITE_URL=https://www.fsia.in
